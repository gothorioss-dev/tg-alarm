#!/usr/bin/env bash
# Entry point of the CI key. Installed on the server as /usr/local/sbin/zoe-alarm-deploy and set
# as a forced command, so the key can only deploy a commit that is already in origin/main.
set -euo pipefail

app_dir=${APP_DIR:-/opt/zoe-alarm}
lock=${LOCK_FILE:-/run/lock/zoe-alarm-deploy.lock}
sha=${SSH_ORIGINAL_COMMAND:-${1:-}}

if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
    echo "A full commit hash is expected" >&2
    exit 2
fi

exec 9>"$lock"
flock -w 1200 9

cd "$app_dir"
git fetch --quiet origin main

if ! git merge-base --is-ancestor "$sha" FETCH_HEAD; then
    echo "Commit $sha is not in main" >&2
    exit 2
fi

previous=$(git rev-parse HEAD)

if [[ $previous != "$sha" ]] && git merge-base --is-ancestor "$sha" "$previous"; then
    echo "A newer commit $previous is already deployed"
    exit 0
fi

git checkout --quiet --detach "$sha"
exec bash deploy/deploy.sh "$previous" "$sha"
